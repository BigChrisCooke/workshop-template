---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found" description="This page doesn't exist.">
  <main class="flex flex-1 flex-col items-center justify-center gap-4 text-center">
    <h1 class="text-4xl font-bold text-slate-900">404</h1>
    <p class="text-slate-500">That page doesn't exist.</p>
    <a href="/" class="text-brand underline">Go home</a>
  </main>
</BaseLayout>
